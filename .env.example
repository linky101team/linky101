# Copy this file to .env.local and fill in real values before running the app.

# Supabase — find these in Project Settings > API on your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Public URL this app is deployed at (used for links in emails/notifications).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (Premium subscriptions) — from the Stripe dashboard.
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_PRICE_ID_MONTHLY=price_monthly_placeholder
STRIPE_PRICE_ID_YEARLY=price_yearly_placeholder

# Web Push (notification permission flow) — generate with `npx web-push generate-vapid-keys`.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY is safe to expose; VAPID_PRIVATE_KEY is a
# secret used server-side only (see supabase/functions/send-push).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@linky101.com

# Linky AI chatbot — optional. Without it, the chatbot falls back to
# keyword-matched canned responses (see lib/linkyAiFallback.ts).
OPENAI_API_KEY=
